# Installed as /etc/shell-sheath.env and loaded by systemd on service start.
# Use KEY=value assignments, without export or shell variable expansion.
# Existing values are preserved when reinstalling.
SHELL_SHEATH_TRANSPORT=http
SHELL_SHEATH_HOST=127.0.0.1
SHELL_SHEATH_PORT=8765
SHELL_SHEATH_LOG_FILE=/var/lib/shell-sheath/requests.jsonl
# Optional additional handlers: comma-separated module:factory names.
# Example: SHELL_SHEATH_LOG_HANDLERS=request_logging:journal_handler
SHELL_SHEATH_LOG_HANDLERS=
# Do not bind to a public interface without authentication and TLS.
# The default MCP endpoint is http://127.0.0.1:8765/mcp
